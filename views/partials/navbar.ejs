<header class="navbar-header">
  <div class="navbar-container">
    <a href="/" class="navbar-brand" title="Snip — URL Shortener">
      <img src="/images/scissor.svg" alt="Snip Logo" class="navbar-logo-icon">
      <span class="navbar-wordmark">Snip</span>
    </a>

    <div class="navbar-actions">
      <div class="avatar-badge" title="<%= locals.user && user.name ? user.name : 'User' %>">
        <%= locals.user && user.name ? user.name.charAt(0).toUpperCase() : 'J' %>
      </div>
      <a href="/user/logout" class="btn btn-logout">LOG OUT</a>
    </div>
  </div>
</header>
