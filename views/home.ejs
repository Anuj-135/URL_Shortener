<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>URL Shortener</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            background: #0f0f1a;
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 60px 16px 40px;
        }

        /* ── Hero ── */
        .hero { text-align: center; margin-bottom: 48px; }
        .badge {
            display: inline-block;
            background: rgba(139,92,246,.15);
            border: 1px solid rgba(139,92,246,.35);
            color: #a78bfa;
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            padding: 4px 14px;
            border-radius: 999px;
            margin-bottom: 20px;
        }
        h1 {
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 700;
            background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            line-height: 1.2;
            margin-bottom: 12px;
        }
        .subtitle { color: #94a3b8; font-size: 1rem; }

        /* ── Card ── */
        .card {
            width: 100%;
            max-width: 640px;
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 20px;
            padding: 36px 32px;
            backdrop-filter: blur(12px);
            box-shadow: 0 25px 50px rgba(0,0,0,.4);
        }

        /* ── Form ── */
        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #94a3b8;
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-bottom: 10px;
        }
        .input-row {
            display: flex;
            gap: 10px;
        }
        input[type="url"] {
            flex: 1;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 12px;
            padding: 14px 18px;
            font-size: 15px;
            color: #e2e8f0;
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }
        input[type="url"]::placeholder { color: #475569; }
        input[type="url"]:focus {
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124,58,237,.25);
        }
        button[type="submit"] {
            background: linear-gradient(135deg, #7c3aed, #2563eb);
            border: none;
            border-radius: 12px;
            padding: 14px 26px;
            font-size: 15px;
            font-weight: 600;
            color: #fff;
            cursor: pointer;
            white-space: nowrap;
            transition: opacity .2s, transform .15s;
        }
        button[type="submit"]:hover { opacity: .88; transform: translateY(-1px); }
        button[type="submit"]:active { transform: translateY(0); opacity: 1; }

        /* ── Generated link banner ── */
        <% if (locals.id) { %>
        .result-banner {
            margin-top: 20px;
            padding: 14px 18px;
            background: rgba(16,185,129,.1);
            border: 1px solid rgba(16,185,129,.3);
            border-radius: 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            animation: fadeIn .4s ease;
        }
        .result-label { font-size: 12px; color: #6ee7b7; font-weight: 600; flex-shrink: 0; }
        .result-link {
            color: #34d399;
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            word-break: break-all;
            transition: color .2s;
        }
        .result-link:hover { color: #6ee7b7; text-decoration: underline; }
        <% } %>

        /* ── History table ── */
        .history { margin-top: 36px; }
        .history h2 {
            font-size: 14px;
            font-weight: 600;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .07em;
            margin-bottom: 14px;
        }
        .table-wrap { overflow-x: auto; }
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        thead th {
            text-align: left;
            padding: 10px 14px;
            color: #64748b;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .06em;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }
        tbody tr {
            transition: background .15s;
        }
        tbody tr:hover { background: rgba(255,255,255,.04); }
        tbody td {
            padding: 12px 14px;
            border-bottom: 1px solid rgba(255,255,255,.05);
            vertical-align: middle;
        }
        .short-link {
            color: #818cf8;
            text-decoration: none;
            font-weight: 500;
            transition: color .2s;
        }
        .short-link:hover { color: #a78bfa; text-decoration: underline; }
        .long-url {
            color: #94a3b8;
            max-width: 260px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }
        .click-badge {
            display: inline-block;
            background: rgba(99,102,241,.15);
            color: #818cf8;
            border-radius: 6px;
            padding: 2px 10px;
            font-size: 12px;
            font-weight: 600;
        }
        .empty {
            text-align: center;
            padding: 30px 0;
            color: #475569;
            font-size: 14px;
        }

        @keyframes fadeIn { from { opacity:0; transform:translateY(-6px) } to { opacity:1; transform:translateY(0) } }

        /* ── Navbar ── */
        .navbar {
            width: 100%;
            max-width: 640px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
            padding: 10px 18px;
            background: rgba(255,255,255,.04);
            border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px;
        }
        .navbar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
            color: #94a3b8;
        }
        .navbar-user strong { color: #e2e8f0; }
        .avatar {
            width: 32px; height: 32px;
            background: linear-gradient(135deg, #7c3aed, #2563eb);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            font-size: 13px; font-weight: 700; color: #fff;
        }
        .logout-btn {
            background: rgba(239,68,68,.12);
            border: 1px solid rgba(239,68,68,.3);
            color: #f87171;
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background .2s;
        }
        .logout-btn:hover { background: rgba(239,68,68,.22); }
    </style>
</head>

<body>

    <!-- ── Navbar ── -->
    <nav class="navbar">
        <div class="navbar-user">
            <div class="avatar"><%= user.name.charAt(0).toUpperCase() %></div>
            <span>Logged in as <strong><%= user.name %></strong></span>
        </div>
        <a href="/user/logout" class="logout-btn">Logout</a>
    </nav>

    <div class="hero">
        <span class="badge">✦ URL Shortener</span>
        <h1>Shorten any link,<br>share it anywhere</h1>
        <p class="subtitle">Paste a long URL and get a clean, trackable short link instantly.</p>
    </div>

    <div class="card">
        <!-- ── Form ── -->
        <form action="/url" method="POST">
            <label class="form-label" for="url-input">Paste your long URL</label>
            <div class="input-row">
                <input
                    id="url-input"
                    type="url"
                    name="url"
                    placeholder="https://www.example.com"
                    required
                />
                <button type="submit">Shorten →</button>
            </div>
        </form>

        <!-- ── Result banner (shown only after form submission) ── -->
        <% if (locals.id) { %>
        <div class="result-banner">
            <span class="result-label">🔗 Short URL</span>
            <a class="result-link" href="/<%= id %>" target="_blank">
                localhost:8001/<%= id %>
            </a>
        </div>
        <% } %>

        <!-- ── All URLs history ── -->
        <div class="history">
            <h2>All shortened URLs</h2>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Short Link</th>
                            <th>Original URL</th>
                            <th>Clicks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (urls && urls.length > 0) { %>
                            <% urls.forEach(url => { %>
                            <tr>
                                <td>
                                    <a class="short-link" href="/<%= url.shortId %>" target="_blank">
                                        /<%= url.shortId %>
                                    </a>
                                </td>
                                <td>
                                    <span class="long-url" title="<%= url.redirectURL %>">
                                        <%= url.redirectURL %>
                                    </span>
                                </td>
                                <td>
                                    <span class="click-badge">
                                        <%= url.visitHistory ? url.visitHistory.length : 0 %>
                                    </span>
                                </td>
                            </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="3" class="empty">No URLs shortened yet. Try one above!</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</body>
</html>