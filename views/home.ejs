<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Snip — Short links, Share it Anywhere</title>
  <meta name="description" content="Paste a long url and get a clean, trackable short link instantly with Snip.">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/components.css">
  <link rel="stylesheet" href="/css/home.css">
</head>
<body>

  <!-- ── Top Navigation Bar ── -->
  <%- include('partials/navbar') %>

  <!-- ── Main Container ── -->
  <main class="main-content">
    
    <!-- ── Hero Section ── -->
    <section class="hero-section">
      <div class="hero-grid">
        
        <!-- Left: Text & URL Input -->
        <div class="hero-text">
          <h1 class="hero-title">
            <span class="title-line">Short links,</span>
            <span class="highlight-box">Share it Anywhere.</span>
          </h1>
          <p class="hero-description">
            Paste a long url and get a clean, trackable short link instantly.
          </p>

          <form class="shorten-form" action="/url" method="POST">
            <div class="form-row">
              <div class="input-wrapper">
                <img src="/images/link.svg" alt="Link Icon" class="input-icon">
                <input
                  id="url-input"
                  type="url"
                  name="url"
                  placeholder="Paste your long link here"
                  class="form-input"
                  required
                />
              </div>
              <button type="submit" class="btn btn-primary btn-shorten">SHORTEN</button>
            </div>

            <!-- Newly Generated Short Link Banner -->
            <% if (locals.id) { %>
            <div class="result-banner">
              <div class="result-info">
                <span class="result-label">Short link created:</span>
                <a class="result-link" href="/<%= id %>" target="_blank">
                  /<%= id %>
                </a>
              </div>
              <button type="button" class="btn-copy" onclick="navigator.clipboard.writeText(window.location.origin + '/<%= id %>'); this.innerText='COPIED!'; setTimeout(() => this.innerText='COPY', 2000)">
                COPY
              </button>
            </div>
            <% } %>
          </form>
        </div>

        <!-- Right: Yellow Hero Illustration Panel -->
        <div class="hero-illustration">
          <div class="illustration-panel">
            <img src="/images/image.png" alt="Snip URL Shortener Illustration" class="illustration-img">
          </div>
        </div>

      </div>
    </section>

    <!-- ── Section Divider ── -->
    <hr class="section-divider">

    <!-- ── Shortened URLs History Table ── -->
    <section class="table-section">
      <h2 class="section-title">All shortened URLs</h2>
      
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th scope="col" class="col-short-link">SHORT LINK</th>
              <th scope="col" class="col-original-url">ORIGINAL URL</th>
              <th scope="col" class="col-clicks">CLICKS</th>
            </tr>
          </thead>
          <tbody>
            <% if (locals.urls && urls.length > 0) { %>
              <% urls.forEach(url => { %>
              <tr>
                <td class="col-short-link">
                  <a class="short-link" href="/<%= url.shortId %>" target="_blank">
                    /<%= url.shortId %>
                  </a>
                </td>
                <td class="col-original-url">
                  <a class="original-url" href="<%= url.redirectURL %>" target="_blank" title="<%= url.redirectURL %>">
                    <%= url.redirectURL %>
                  </a>
                </td>
                <td class="col-clicks">
                  <span class="clicks-count">
                    <%= url.visitHistory ? url.visitHistory.length.toLocaleString() : 0 %>
                  </span>
                </td>
              </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="3" class="table-empty">
                  No URLs shortened yet. Paste a link above to get started!
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>

  </main>

</body>
</html>